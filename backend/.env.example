# Same database the Next.js app uses (see the root .env.example).
DATABASE_URL=postgres://app:app@localhost:5433/langgame

# Grader. "anthropic" calls Claude; "mock" is for local dev/tests only and produces fake scores.
GRADER=anthropic
# Leave unset if you use `ant auth login`; the SDK also reads credentials from there.
ANTHROPIC_API_KEY=your-anthropic-key
GRADER_MODEL=claude-opus-5
GRADER_EFFORT=medium

# Optional tuning (defaults shown)
# POLL_INTERVAL_MS=3000
# SCORING_GRACE_SECS=35
# SCORING_MAX_ATTEMPTS=3
# MIN_WORDS_TO_SCORE=5
