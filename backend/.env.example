# Same database the Next.js app uses (see the root .env.example).
DATABASE_URL=postgres://app:app@localhost:5433/langgame

# Grader. "gemini" calls Google Gemini; "mock" is for local dev/tests only and produces fake scores.
GRADER=gemini
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GRADER_MODEL=gemini-2.5-flash
# GRADER_THINKING=low        # optional: minimal | low | medium | high

# Optional tuning (defaults shown)
# POLL_INTERVAL_MS=3000
# SCORING_GRACE_SECS=35
# SCORING_MAX_ATTEMPTS=3
# MIN_WORDS_TO_SCORE=5
